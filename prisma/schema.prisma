// Dommus Negotii — Phase 1 data model (PRD §7).
// Milestone 1a so far: shell (auth, modules, roles, settings, audit,
// notifications), ledger, evidence and credit members. Loans follow in 1b.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["shell", "ledger", "evidence", "credit"]
}

// ─────────────────────── shell: auth (Better Auth) ───────────────────────
// Field names must match Better Auth 1.7 (core + twoFactor + phoneNumber plugins).

/// A portal login (PRD F1). Separate from module entities such as Member.
model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  image               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  twoFactorEnabled    Boolean?             @default(false) @map("two_factor_enabled")
  phoneNumber         String?              @unique @map("phone_number")
  phoneNumberVerified Boolean?             @map("phone_number_verified")
  /// Set when an Admin deactivates the user; all sessions are revoked (PRD F1).
  deactivatedAt       DateTime?            @map("deactivated_at") @db.Timestamptz(3)
  /// Where status messages go (PRD F15). Null = the default: SMS for members, email for staff.
  preferredChannel    NotificationChannel? @map("preferred_channel")
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  roles               UserModuleRole[]
  member              Member?

  @@map("user")
  @@schema("shell")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Refreshed by Better Auth on use (at most once per updateAge): last activity.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("shell")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
  @@schema("shell")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
  @@schema("shell")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
  @@schema("shell")
}

// ───────────────────────────── shell ─────────────────────────────

enum ModuleStatus {
  LIVE
  DEGRADED
  OFFLINE

  @@schema("shell")
}

enum Role {
  MEMBER
  TREASURER
  FINANCE_MANAGER
  CASHIER
  LOAN_OFFICER
  MANAGEMENT
  AUDITOR
  ADMIN
  GMD
  SECRETARY

  @@schema("shell")
}

model Module {
  code         String           @id
  name         String
  status       ModuleStatus     @default(LIVE)
  eventTypes   String[]         @map("event_types")
  registeredAt DateTime         @default(now()) @map("registered_at") @db.Timestamptz(3)
  roles        UserModuleRole[]

  @@map("module")
  @@schema("shell")
}

model UserModuleRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  moduleCode   String    @map("module_code")
  module       Module    @relation(fields: [moduleCode], references: [code])
  role         Role
  assignedById String    @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@unique([userId, moduleCode, role])
  @@map("user_module_role")
  @@schema("shell")
}

/// Insert-only (PRD F2): the app role has no UPDATE/DELETE and a trigger blocks both.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userId      String?  @map("user_id")
  ipAddress   String?  @map("ip_address")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  evidenceRef String?  @map("evidence_ref") @db.Uuid

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@map("audit_log")
  @@schema("shell")
}

/// Effective-dated settings history. The current value of a key is the row with
/// the latest effective_from on or before today (Africa/Lagos).
model Setting {
  id              String                @id @default(uuid()) @db.Uuid
  key             String
  value           Json
  effectiveFrom   DateTime              @map("effective_from") @db.Date
  createdById     String                @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set for financial settings: the change request that approved this value.
  changeRequestId String?               @unique @map("change_request_id") @db.Uuid
  changeRequest   SettingChangeRequest? @relation(fields: [changeRequestId], references: [id])

  @@index([key, effectiveFrom, createdAt])
  @@map("setting")
  @@schema("shell")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Taken back by the person who proposed it, before a decision.
  WITHDRAWN

  @@schema("shell")
}

/// Financial setting changes: Admin proposes, Management approves (PRD F2).
model SettingChangeRequest {
  id            String              @id @default(uuid()) @db.Uuid
  key           String
  proposedValue Json                @map("proposed_value")
  effectiveFrom DateTime            @map("effective_from") @db.Date
  reason        String
  proposedById  String              @map("proposed_by_id")
  proposedAt    DateTime            @default(now()) @map("proposed_at") @db.Timestamptz(3)
  status        ChangeRequestStatus @default(PENDING)
  decidedById   String?             @map("decided_by_id")
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote  String?             @map("decision_note")
  setting       Setting?

  /// At most one open proposal per setting.
  @@unique([key], map: "setting_change_request_one_pending", where: raw("status = 'PENDING'"))
  @@index([status])
  @@map("setting_change_request")
  @@schema("shell")
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("shell")
}

/// One run of a scheduled job (PRD §5): every job is idempotent and logs each run.
model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  job        String
  /// "cron" for Vercel Cron, otherwise the user id that pressed "Run now".
  trigger    String
  status     JobRunStatus @default(RUNNING)
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)
  /// What the run did, e.g. { deletedSessions: 4 }.
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@map("job_run")
  @@schema("shell")
}

enum ExceptionStatus {
  OPEN
  UNDER_REVIEW
  CLOSED

  @@schema("shell")
}

/// Portal-wide exception register (PRD F11). Modules raise exceptions here;
/// only the GMD closes them, with a reason and evidence. Raising is
/// idempotent on dedupe_key.
model ExceptionRecord {
  id              String          @id @default(uuid()) @db.Uuid
  moduleCode      String          @map("module_code")
  /// e.g. DUPLICATE_EVIDENCE, EVIDENCE_TAMPERED, SHORTFALL, EXCESS, ...
  type            String
  dedupeKey       String          @unique @map("dedupe_key")
  status          ExceptionStatus @default(OPEN)
  title           String
  details         Json            @default("{}")
  /// Kobo, when the exception is about an amount.
  amount          BigInt?
  raisedAt        DateTime        @default(now()) @map("raised_at") @db.Timestamptz(3)
  raisedById      String?         @map("raised_by_id")
  reviewedById    String?         @map("reviewed_by_id")
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?         @map("review_note")
  closedById      String?         @map("closed_by_id")
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(3)
  closeReason     String?         @map("close_reason")
  closeEvidenceId String?         @map("close_evidence_id") @db.Uuid

  @@index([status, raisedAt])
  @@index([moduleCode, type])
  @@map("exception")
  @@schema("shell")
}

enum NotificationChannel {
  SMS
  EMAIL

  @@schema("shell")
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED

  @@schema("shell")
}

model Notification {
  id               String              @id @default(uuid()) @db.Uuid
  idempotencyKey   String              @unique @map("idempotency_key")
  channel          NotificationChannel
  recipient        String
  template         String
  payload          Json                @default("{}")
  status           NotificationStatus  @default(QUEUED)
  provider         String?
  providerResponse Json?               @map("provider_response")
  attempts         Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt           DateTime?           @map("sent_at") @db.Timestamptz(3)
  /// Kept only while a retryable message is waiting to be sent again (never
  /// for codes or links); cleared once it is sent or given up on.
  retrySubject     String?             @map("retry_subject")
  retryText        String?             @map("retry_text")

  @@index([status, createdAt])
  @@map("notification")
  @@schema("shell")
}

/// Request counts for rate limiting, shared by every server instance (PRD §5).
/// Used by Better Auth (sign-in, codes, resets) and the public receipt check.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
  @@schema("shell")
}

/// STAGING ONLY: the full text of messages the console provider "sent", so
/// testers can follow invitation links and use codes. Written only when
/// APP_STAGE=staging; rows older than 24 hours are deleted. Always empty in production.
model StagingOutbox {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  recipient String
  subject   String?
  template  String
  text      String
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("staging_outbox")
  @@schema("shell")
}

// ───────────────────────────── ledger ─────────────────────────────

enum LedgerEventType {
  OPENING_BALANCE
  CASH_IN
  CASH_OUT
  PRINCIPAL_RECOVERY
  INTEREST_INCOME
  DEPOSIT_CREDITED
  DEPOSIT_REFUNDED
  SCHEDULE_ACCEPTED
  SCHEDULE_POSTED
  LODGEMENT_BANK_VERIFIED
  LODGEMENT_APPLIED
  LODGEMENT_UNAPPLIED
  BANK_DEPOSIT

  @@schema("ledger")
}

enum LedgerSource {
  REMITTANCE_SCHEDULE
  BANK_SLIP
  BANK_STATEMENT
  DISBURSEMENT_VOUCHER
  REFUND_VOUCHER
  LEGACY_IMPORT
  RECEIPT_ENTRY
  EXCEL_BATCH
  LIVE_PAYMENT

  @@schema("ledger")
}

/// Append-only (PRD F4). Money in integer kobo. A reversal negates the original
/// and points to it; an event can be reversed at most once.
model LedgerEvent {
  id               String          @id @default(uuid()) @map("event_id") @db.Uuid
  occurredAt       DateTime        @map("occurred_at") @db.Date
  postedAt         DateTime        @default(now()) @map("posted_at") @db.Timestamptz(3)
  moduleCode       String          @map("module_code")
  eventType        LedgerEventType @map("event_type")
  source           LedgerSource
  evidenceRefs     String[]        @map("evidence_refs") @db.Uuid
  portalUserId     String          @map("portal_user_id")
  moduleEntityType String          @map("module_entity_type")
  moduleEntityId   String          @map("module_entity_id")
  bankAccountId    String?         @map("bank_account_id")
  currency         String          @default("NGN") @db.Char(3)
  cashAmount       BigInt          @default(0) @map("cash_amount")
  revenueAmount    BigInt          @default(0) @map("revenue_amount")
  depositDelta     BigInt          @default(0) @map("deposit_delta")
  principalAmount  BigInt          @default(0) @map("principal_amount")
  interestAmount   BigInt          @default(0) @map("interest_amount")
  retentionAmount  BigInt          @default(0) @map("retention_amount")
  status           String          @default("POSTED")
  uniquenessKey    String          @unique @map("uniqueness_key")
  reversesEventId  String?         @unique @map("reverses_event_id") @db.Uuid
  reverses         LedgerEvent?    @relation("Reversal", fields: [reversesEventId], references: [id])
  reversedBy       LedgerEvent?    @relation("Reversal")
  schemaVersion    Int             @default(2) @map("schema_version")
  metadata         Json            @default("{}")

  @@index([moduleCode, eventType, occurredAt])
  @@index([moduleEntityType, moduleEntityId])
  @@index([bankAccountId, occurredAt])
  @@map("ledger_event")
  @@schema("ledger")
}

// ───────────────────────────── evidence ─────────────────────────────

/// Never deleted (PRD F3). Same checksum is stored once.
model EvidenceFile {
  id           String         @id @default(uuid()) @db.Uuid
  filename     String
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @unique @db.Char(64)
  storageKey   String         @unique @map("storage_key")
  uploadedById String         @map("uploaded_by_id")
  uploadedAt   DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  links        EvidenceLink[]

  @@map("evidence_file")
  @@schema("evidence")
}

/// An upload in progress: the browser PUTs the file to staging/<id> with a
/// short-lived presigned URL, then the server checks it, hashes it and files
/// it under files/<sha256> (PRD F3).
model EvidenceUpload {
  id             String    @id @default(uuid()) @db.Uuid
  stagingKey     String    @unique @map("staging_key")
  declaredName   String    @map("declared_name")
  declaredType   String    @map("declared_type")
  declaredSize   Int       @map("declared_size")
  uploadedById   String    @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  evidenceId     String?   @map("evidence_id") @db.Uuid
  rejectedReason String?   @map("rejected_reason")

  @@index([uploadedById, createdAt])
  @@map("evidence_upload")
  @@schema("evidence")
}

enum EvidenceKind {
  PRIMARY
  SUPPORTING

  @@schema("evidence")
}

model EvidenceLink {
  id              String       @id @default(uuid()) @db.Uuid
  evidenceId      String       @map("evidence_id") @db.Uuid
  evidence        EvidenceFile @relation(fields: [evidenceId], references: [id])
  entityType      String       @map("entity_type")
  entityId        String       @map("entity_id")
  kind            EvidenceKind
  /// The submission this link belongs to, e.g. "REMITTANCE_SCHEDULE:<id>" (PRD F3).
  submissionKey   String       @map("submission_key")
  /// Required when this file is already primary evidence of another submission.
  duplicateReason String?      @map("duplicate_reason")
  linkedById      String       @map("linked_by_id")
  linkedAt        DateTime     @default(now()) @map("linked_at") @db.Timestamptz(3)

  @@unique([evidenceId, entityType, entityId])
  @@index([evidenceId, kind])
  @@index([entityType, entityId])
  @@map("evidence_link")
  @@schema("evidence")
}

// ───────────────────────────── credit: members (PRD F5) ─────────────────────────────

/// An authorised origin of remittance schedules, e.g. a payroll office (PRD F9). Admin-configured.
model RemittanceSource {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  active      Boolean              @default(true)
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  members     Member[]
  invitations Invitation[]
  advices     SourceAdvice[]
  schedules   RemittanceSchedule[]

  @@map("remittance_source")
  @@schema("credit")
}

enum InvitationType {
  /// A prospective member registers through the link.
  REGISTRATION
  /// A bulk-imported member sets up their login.
  ACTIVATION

  @@schema("credit")
}

/// A personal, single-use, expiring registration link (PRD F5). Only the
/// SHA-256 of the token is stored. Resending replaces the token.
model Invitation {
  id                 String            @id @default(uuid()) @db.Uuid
  type               InvitationType    @default(REGISTRATION)
  fullName           String            @map("full_name")
  /// E.164, e.g. +2348031234567. Registration must verify this exact number.
  phone              String
  email              String?
  remittanceSourceId String?           @map("remittance_source_id") @db.Uuid
  remittanceSource   RemittanceSource? @relation(fields: [remittanceSourceId], references: [id])
  tokenHash          String            @unique @map("token_hash") @db.Char(64)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)
  sentById           String            @map("sent_by_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt         DateTime          @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  sendCount          Int               @default(1) @map("send_count")
  /// False when the SMS provider refused the last send.
  lastSendOk         Boolean           @default(true) @map("last_send_ok")
  openedAt           DateTime?         @map("opened_at") @db.Timestamptz(3)
  registeredAt       DateTime?         @map("registered_at") @db.Timestamptz(3)
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?           @map("revoked_by_id")
  member             Member?

  @@index([phone, createdAt])
  @@index([sentById, createdAt])
  @@map("invitation")
  @@schema("credit")
}

enum MemberStatus {
  PENDING
  ACTIVE
  DECLINED
  EXITED

  @@schema("credit")
}

/// A cooperative member (PRD F5). Linked to one portal login.
model Member {
  id                 String                 @id @default(uuid()) @db.Uuid
  /// System-issued member number, MCS-NNNNN, given when the record is created.
  memberNo           String                 @unique @default(dbgenerated("('MCS-'::text || lpad((nextval('credit.member_no_seq'::regclass))::text, 5, '0'::text))")) @map("member_no")
  userId             String                 @unique @map("user_id")
  user               User                   @relation(fields: [userId], references: [id])
  fullName           String                 @map("full_name")
  phone              String                 @unique
  email              String?
  address            String
  moaumIdNumber      String                 @unique @map("moaum_id_number")
  /// Evidence id of the ID card scan; null means KYC incomplete.
  idScanEvidenceId   String?                @map("id_scan_evidence_id") @db.Uuid
  nextOfKinName      String                 @map("next_of_kin_name")
  nextOfKinPhone     String                 @map("next_of_kin_phone")
  /// Null means the member pays directly ("None — pays directly").
  remittanceSourceId String?                @map("remittance_source_id") @db.Uuid
  remittanceSource   RemittanceSource?      @relation(fields: [remittanceSourceId], references: [id])
  /// The member's staff number on that source's payroll; remittance files are matched on it.
  payrollStaffNo     String?                @map("payroll_staff_no")
  status             MemberStatus           @default(PENDING)
  /// Null until an imported member accepts the NDPA notice at first sign-in.
  consentAt          DateTime?              @map("consent_at") @db.Timestamptz(3)
  consentVersion     String?                @map("consent_version")
  invitationId       String?                @unique @map("invitation_id") @db.Uuid
  invitation         Invitation?            @relation(fields: [invitationId], references: [id])
  invitedById        String?                @map("invited_by_id")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedById       String?                @map("reviewed_by_id")
  reviewedAt         DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  declineReason      String?                @map("decline_reason")
  profileChanges     ProfileChangeRequest[]
  loans              Loan[]                 @relation("MemberLoans")
  remittanceRows     RemittanceRow[]
  directPayments     DirectPaymentTag[]
  refunds            Refund[]
  guarantees         Guarantor[]            @relation("MemberGuarantees")

  @@unique([remittanceSourceId, payrollStaffNo])
  @@index([status, createdAt])
  @@map("member")
  @@schema("credit")
}

// ───────────────────────────── credit: profile changes (PRD F5) ─────────────────────────────

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("credit")
}

/// A member's request to change their contact or KYC details; the Loan Officer approves it (PRD F5).
model ProfileChangeRequest {
  id              String              @id @default(uuid()) @db.Uuid
  memberId        String              @map("member_id") @db.Uuid
  member          Member              @relation(fields: [memberId], references: [id])
  /// Only the fields being changed: { fullName?, phone?, email?, address?, moaumIdNumber?, idScanEvidenceId?, nextOfKinName?, nextOfKinPhone?, remittanceSourceId? }.
  changes         Json
  /// The same fields as they were when the request was made.
  before          Json
  note            String?
  /// Supporting document (required for name or MOAUM ID changes).
  evidenceId      String?             @map("evidence_id") @db.Uuid
  /// Set when a new phone number was confirmed with an SMS code.
  phoneVerifiedAt DateTime?           @map("phone_verified_at") @db.Timestamptz(3)
  status          ProfileChangeStatus @default(PENDING)
  requestedById   String              @map("requested_by_id")
  requestedAt     DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById     String?             @map("decided_by_id")
  decidedAt       DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?             @map("decision_note")

  /// At most one open request per member.
  @@unique([memberId], map: "profile_change_request_one_pending", where: raw("status = 'PENDING'"))
  @@index([status, requestedAt])
  @@index([memberId, requestedAt])
  @@map("profile_change_request")
  @@schema("credit")
}

// ───────────────────────────── credit: loans (PRD F7) ─────────────────────────────

enum LoanStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  RECOMMENDED
  APPROVED
  DISBURSEMENT_PENDING
  ACTIVE
  CLOSED
  DECLINED
  REJECTED
  CANCELLED

  @@schema("credit")
}

/// A loan from application to closure (PRD F7). Requested and approved terms are kept separately.
model Loan {
  id                    String           @id @default(uuid()) @db.Uuid
  /// CSS-YYYY-NNNNN, issued when the application is submitted.
  loanAccountNo         String?          @unique @map("loan_account_no")
  /// The old number of a loan brought in by the legacy import (F8).
  legacyAccountNo       String?          @unique @map("legacy_account_no")
  memberId              String           @map("member_id") @db.Uuid
  member                Member           @relation("MemberLoans", fields: [memberId], references: [id])
  status                LoanStatus       @default(DRAFT)
  /// Captured by a Loan Officer from a signed paper form.
  assisted              Boolean          @default(false)
  purpose               String
  amountRequested       BigInt           @map("amount_requested")
  tenureRequested       Int              @map("tenure_requested")
  amountApproved        BigInt?          @map("amount_approved")
  tenureApproved        Int?             @map("tenure_approved")
  /// The rate in force on the approval date, kept for the life of the loan.
  rateBps               Int?             @map("rate_bps")
  /// Disbursement date: value date of the verified voucher.
  d0                    DateTime?        @db.Date
  closedOn              DateTime?        @map("closed_on") @db.Date
  /// Signed paper application form (assisted applications).
  applicationEvidenceId String?          @map("application_evidence_id") @db.Uuid
  /// The binding schedule as generated at disbursement (approved amount, tenure, rate; d0).
  bindingSchedule       Json?            @map("binding_schedule")
  createdById           String           @map("created_by_id")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  guarantor             Guarantor?
  transitions           LoanTransition[]
  vouchers              Voucher[]
  remittanceRows        RemittanceRow[]

  @@index([memberId, status])
  @@index([status, updatedAt])
  @@map("loan")
  @@schema("credit")
}

/// The one guarantor of a loan: a member (by MOAUM ID) or a non-member (by phone).
model Guarantor {
  id             String  @id @default(uuid()) @db.Uuid
  loanId         String  @unique @map("loan_id") @db.Uuid
  loan           Loan    @relation(fields: [loanId], references: [id])
  memberId       String? @map("member_id") @db.Uuid
  member         Member? @relation("MemberGuarantees", fields: [memberId], references: [id])
  moaumIdNumber  String? @map("moaum_id_number")
  fullName       String  @map("full_name")
  /// E.164.
  phone          String
  address        String
  relationship   String
  /// Signed guarantor form; required before submission.
  formEvidenceId String? @map("form_evidence_id") @db.Uuid

  @@index([moaumIdNumber])
  @@index([phone])
  @@map("guarantor")
  @@schema("credit")
}

/// Every status change of a loan, with who, when and why (PRD F7).
model LoanTransition {
  id         String      @id @default(uuid()) @db.Uuid
  loanId     String      @map("loan_id") @db.Uuid
  loan       Loan        @relation(fields: [loanId], references: [id])
  fromStatus LoanStatus? @map("from_status")
  toStatus   LoanStatus  @map("to_status")
  byUserId   String      @map("by_user_id")
  at         DateTime    @default(now()) @db.Timestamptz(3)
  comment    String?

  @@index([loanId, at])
  @@map("loan_transition")
  @@schema("credit")
}

/// Loan numbers run per year: CSS-2026-00001, …
model LoanNumberSequence {
  year Int @id
  last Int @default(0)

  @@map("loan_number_sequence")
  @@schema("credit")
}

/// A MOAUM bank account money is paid from or into (configured by Admin; statements come in 1c).
model BankAccount {
  id             String               @id @default(uuid()) @db.Uuid
  bankName       String               @map("bank_name")
  branch         String?
  accountName    String               @map("account_name")
  accountNumber  String               @unique @map("account_number")
  active         Boolean              @default(true)
  createdById    String               @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  vouchers       Voucher[]
  lodgements     Lodgement[]
  openings       BankOpeningBalance[]
  mapping        StatementMapping?
  statements     BankStatement[]
  statementLines BankStatementLine[]

  @@map("bank_account")
  @@schema("credit")
}

enum VoucherType {
  DISBURSEMENT
  REFUND

  @@schema("credit")
}

enum VoucherStatus {
  PREPARED
  VERIFIED
  RETURNED

  @@schema("credit")
}

/// Disbursement (and later refund) vouchers: Cashier prepares, Finance Manager verifies or returns.
model Voucher {
  id                   String             @id @default(uuid()) @db.Uuid
  type                 VoucherType
  loanId               String?            @map("loan_id") @db.Uuid
  loan                 Loan?              @relation(fields: [loanId], references: [id])
  status               VoucherStatus      @default(PREPARED)
  amount               BigInt
  /// Value date of the transfer: becomes the loan's d0.
  valueDate            DateTime           @map("value_date") @db.Date
  bankAccountId        String             @map("bank_account_id") @db.Uuid
  bankAccount          BankAccount        @relation(fields: [bankAccountId], references: [id])
  transferRef          String             @map("transfer_ref")
  beneficiaryName      String             @map("beneficiary_name")
  beneficiaryBank      String             @map("beneficiary_bank")
  beneficiaryAccountNo String             @map("beneficiary_account_no")
  evidenceId           String             @map("evidence_id") @db.Uuid
  preparedById         String             @map("prepared_by_id")
  preparedAt           DateTime           @default(now()) @map("prepared_at") @db.Timestamptz(3)
  verifiedById         String?            @map("verified_by_id")
  verifiedAt           DateTime?          @map("verified_at") @db.Timestamptz(3)
  returnReason         String?            @map("return_reason")
  ledgerEventId        String?            @map("ledger_event_id") @db.Uuid
  statementLine        BankStatementLine?
  /// For a REFUND voucher: the refund it pays.
  refundId             String?            @map("refund_id") @db.Uuid
  refund               Refund?            @relation(fields: [refundId], references: [id])

  /// At most one voucher waiting for verification per loan.
  @@unique([loanId], map: "voucher_one_prepared", where: raw("status = 'PREPARED'"))
  @@unique([refundId], map: "voucher_one_prepared_refund", where: raw("status = 'PREPARED'"))
  @@index([loanId])
  @@map("voucher")
  @@schema("credit")
}

// ───────────────────────────── credit: remittance (PRD F9) ─────────────────────────────

enum AdviceStatus {
  AVAILABLE
  USED
  SUPERSEDED

  @@schema("credit")
}

/// What a payroll source says it deducted per member for a month; uploaded by the Finance Manager (PRD F9).
model SourceAdvice {
  id                 String              @id @default(uuid()) @db.Uuid
  remittanceSourceId String              @map("remittance_source_id") @db.Uuid
  remittanceSource   RemittanceSource    @relation(fields: [remittanceSourceId], references: [id])
  /// YYYY-MM.
  monthCovered       String              @map("month_covered")
  adviceReference    String              @map("advice_reference")
  controlTotal       BigInt              @map("control_total")
  rowCount           Int                 @map("row_count")
  /// The original document received from the source.
  evidenceId         String              @map("evidence_id") @db.Uuid
  status             AdviceStatus        @default(AVAILABLE)
  uploadedById       String              @map("uploaded_by_id")
  uploadedAt         DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// The advice this one replaces (the source's corrected document), with the reason.
  supersedesId       String?             @unique @map("supersedes_id") @db.Uuid
  supersedes         SourceAdvice?       @relation("AdviceSupersedes", fields: [supersedesId], references: [id])
  supersededBy       SourceAdvice?       @relation("AdviceSupersedes")
  supersedeReason    String?             @map("supersede_reason")
  rows               SourceAdviceRow[]
  schedule           RemittanceSchedule?
  corrections        CorrectionBatch[]

  @@unique([remittanceSourceId, adviceReference])
  @@map("source_advice")
  @@schema("credit")
}

model SourceAdviceRow {
  id            String       @id @default(uuid()) @db.Uuid
  adviceId      String       @map("advice_id") @db.Uuid
  advice        SourceAdvice @relation(fields: [adviceId], references: [id])
  moaumIdNumber String       @map("moaum_id_number")
  memberName    String       @map("member_name")
  amount        BigInt

  @@unique([adviceId, moaumIdNumber])
  @@map("source_advice_row")
  @@schema("credit")
}

enum ScheduleType {
  REGULAR
  SUPPLEMENTARY

  @@schema("credit")
}

/// A posted monthly remittance schedule from a payroll source (PRD F9). Rows are allocated per F6.
model RemittanceSchedule {
  id                 String            @id @default(uuid()) @db.Uuid
  remittanceSourceId String            @map("remittance_source_id") @db.Uuid
  remittanceSource   RemittanceSource  @relation(fields: [remittanceSourceId], references: [id])
  scheduleReference  String            @map("schedule_reference")
  monthCovered       String            @map("month_covered")
  type               ScheduleType
  adviceId           String            @unique @map("advice_id") @db.Uuid
  advice             SourceAdvice      @relation(fields: [adviceId], references: [id])
  submittedBy        String            @map("submitted_by")
  controlTotal       BigInt            @map("control_total")
  rowCount           Int               @map("row_count")
  /// The uploaded schedule file.
  evidenceId         String            @map("evidence_id") @db.Uuid
  checksum           String
  uploadedById       String            @map("uploaded_by_id")
  postedAt           DateTime          @default(now()) @map("posted_at") @db.Timestamptz(3)
  rows               RemittanceRow[]
  lodgements         Lodgement[]
  corrections        CorrectionBatch[]

  @@unique([remittanceSourceId, scheduleReference])
  /// One REGULAR schedule per source per month.
  @@unique([remittanceSourceId, monthCovered], map: "remittance_schedule_one_regular", where: raw("type = 'REGULAR'"))
  @@map("remittance_schedule")
  @@schema("credit")
}

model RemittanceRow {
  id                String             @id @default(uuid()) @db.Uuid
  scheduleId        String             @map("schedule_id") @db.Uuid
  schedule          RemittanceSchedule @relation(fields: [scheduleId], references: [id])
  rowNo             Int                @map("row_no")
  rowType           String             @map("row_type")
  memberId          String             @map("member_id") @db.Uuid
  member            Member             @relation(fields: [memberId], references: [id])
  loanId            String?            @map("loan_id") @db.Uuid
  loan              Loan?              @relation(fields: [loanId], references: [id])
  /// Posted straight to the member's Overpayment Credit (closed loan or no active loan).
  toCredit          Boolean            @map("to_credit")
  amount            BigInt
  paymentDate       DateTime           @map("payment_date") @db.Date
  periodCovered     String?            @map("period_covered")
  receiptNo         String?            @map("receipt_no")
  note              String?
  rowHash           String             @map("row_hash")
  /// Set when a correction batch reverses the row.
  reversedAt        DateTime?          @map("reversed_at") @db.Timestamptz(3)
  reversedById      String?            @map("reversed_by_correction_id") @db.Uuid
  reversedBy        CorrectionBatch?   @relation("CorrectionReversals", fields: [reversedById], references: [id])
  /// Set on a replacement row added by a correction batch.
  correctionId      String?            @map("correction_id") @db.Uuid
  correction        CorrectionBatch?   @relation("CorrectionReplacements", fields: [correctionId], references: [id])
  reclassifications Reclassification[]

  @@unique([scheduleId, rowNo])
  /// No two live rows of a schedule are the same payment.
  @@unique([scheduleId, rowHash], map: "remittance_row_live_hash", where: raw("reversed_at IS NULL"))
  @@index([loanId])
  @@index([memberId])
  @@map("remittance_row")
  @@schema("credit")
}

enum CorrectionStatus {
  PREPARED
  VERIFIED
  RETURNED

  @@schema("credit")
}

/// A correction to a posted schedule (PRD F9): rows to reverse plus replacement rows, with a reason and evidence. Treasurer prepares, Finance Manager verifies.
model CorrectionBatch {
  id              String             @id @default(uuid()) @db.Uuid
  scheduleId      String             @map("schedule_id") @db.Uuid
  schedule        RemittanceSchedule @relation(fields: [scheduleId], references: [id])
  status          CorrectionStatus   @default(PREPARED)
  reason          String
  /// The document that explains the correction.
  evidenceId      String             @map("evidence_id") @db.Uuid
  /// The advice the corrected schedule must match: its own, or one superseding it.
  adviceId        String             @map("advice_id") @db.Uuid
  advice          SourceAdvice       @relation(fields: [adviceId], references: [id])
  /// Row ids to reverse and the replacement rows' cells; re-checked at verification.
  payload         Json
  preparedById    String             @map("prepared_by_id")
  preparedAt      DateTime           @default(now()) @map("prepared_at") @db.Timestamptz(3)
  decidedById     String?            @map("decided_by_id")
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz(3)
  returnComment   String?            @map("return_comment")
  reversedRows    RemittanceRow[]    @relation("CorrectionReversals")
  replacementRows RemittanceRow[]    @relation("CorrectionReplacements")

  /// One correction in preparation per schedule.
  @@unique([scheduleId], map: "correction_batch_one_prepared", where: raw("status = 'PREPARED'"))
  @@index([scheduleId, preparedAt])
  @@map("correction_batch")
  @@schema("credit")
}

enum LodgementStatus {
  UNVERIFIED
  BANK_VERIFIED
  APPLIED

  @@schema("credit")
}

/// Payroll money paid into a MOAUM bank account, declared on a schedule's Lodgements sheet; verified against the bank in 1c.
model Lodgement {
  id            String              @id @default(uuid()) @db.Uuid
  scheduleId    String?             @map("schedule_id") @db.Uuid
  schedule      RemittanceSchedule? @relation(fields: [scheduleId], references: [id])
  bankAccountId String              @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])
  depositDate   DateTime            @map("deposit_date") @db.Date
  reference     String
  amount        BigInt
  depositor     String?
  note          String?
  status        LodgementStatus     @default(UNVERIFIED)
  /// bank account + reference + date + amount: a lodgement is declared once.
  uniquenessKey String              @unique @map("uniqueness_key")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Finance Manager's confirmation against the statement credit (BANK_VERIFIED).
  verifiedById  String?             @map("verified_by_id")
  verifiedAt    DateTime?           @map("verified_at") @db.Timestamptz(3)
  /// Cashier's record and apply (APPLIED): CASH_IN + LODGEMENT_APPLIED.
  appliedById   String?             @map("applied_by_id")
  appliedAt     DateTime?           @map("applied_at") @db.Timestamptz(3)
  cashEventId   String?             @map("cash_event_id") @db.Uuid
  statementLine BankStatementLine?
  tag           DirectPaymentTag?   @relation("TagLodgement")

  @@map("lodgement")
  @@schema("credit")
}

// ───────────────────────────── credit: bank, Track B (PRD F10) ─────────────────────────────

enum OpeningBalanceStatus {
  PREPARED
  COMMITTED
  REJECTED

  @@schema("credit")
}

/// A MOAUM bank account's balance at the go-live date (PRD F10). Admin uploads, the Finance Manager commits (different users).
model BankOpeningBalance {
  id            String               @id @default(uuid()) @db.Uuid
  bankAccountId String               @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount          @relation(fields: [bankAccountId], references: [id])
  asOf          DateTime             @map("as_of") @db.Date
  amount        BigInt
  /// The bank statement showing the balance.
  evidenceId    String               @map("evidence_id") @db.Uuid
  status        OpeningBalanceStatus @default(PREPARED)
  uploadedById  String               @map("uploaded_by_id")
  uploadedAt    DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  decidedById   String?              @map("decided_by_id")
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz(3)
  rejectReason  String?              @map("reject_reason")
  ledgerEventId String?              @map("ledger_event_id") @db.Uuid

  /// One opening balance per account, prepared or committed.
  @@unique([bankAccountId], map: "bank_opening_balance_one_live", where: raw("status <> 'REJECTED'"))
  @@map("bank_opening_balance")
  @@schema("credit")
}

/// How one bank's statement export maps onto the standard template, saved per account (PRD F10).
model StatementMapping {
  bankAccountId String      @id @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  /// { transaction_date: "<their header>", …, dateFormat }
  mapping       Json
  updatedById   String      @map("updated_by_id")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("statement_mapping")
  @@schema("credit")
}

/// An imported bank statement. Its opening balance continues the previous statement's closing balance (PRD F10).
model BankStatement {
  id             String              @id @default(uuid()) @db.Uuid
  bankAccountId  String              @map("bank_account_id") @db.Uuid
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id])
  periodFrom     DateTime            @map("period_from") @db.Date
  periodTo       DateTime            @map("period_to") @db.Date
  openingBalance BigInt              @map("opening_balance")
  closingBalance BigInt              @map("closing_balance")
  /// The statement file as received.
  evidenceId     String              @map("evidence_id") @db.Uuid
  checksum       String
  lineCount      Int                 @map("line_count")
  /// Lines already imported from an overlapping statement.
  skippedCount   Int                 @map("skipped_count")
  uploadedById   String              @map("uploaded_by_id")
  uploadedAt     DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  lines          BankStatementLine[]

  @@index([bankAccountId, periodTo])
  @@map("bank_statement")
  @@schema("credit")
}

enum BankDirection {
  CREDIT
  DEBIT

  @@schema("credit")
}

/// One line of a bank statement, and what it was matched to.
model BankStatementLine {
  id              String            @id @default(uuid()) @db.Uuid
  statementId     String            @map("statement_id") @db.Uuid
  statement       BankStatement     @relation(fields: [statementId], references: [id])
  bankAccountId   String            @map("bank_account_id") @db.Uuid
  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id])
  transactionDate DateTime          @map("transaction_date") @db.Date
  valueDate       DateTime?         @map("value_date") @db.Date
  direction       BankDirection
  amount          BigInt
  reference       String
  narration       String
  runningBalance  BigInt?           @map("running_balance")
  /// account + date + direction + amount + reference + running balance.
  uniquenessKey   String            @unique @map("uniqueness_key")
  /// A credit confirmed as a lodgement (payroll, or a tagged direct payment once scheduled).
  lodgementId     String?           @unique @map("lodgement_id") @db.Uuid
  lodgement       Lodgement?        @relation(fields: [lodgementId], references: [id])
  /// A debit matched to a verified disbursement or refund voucher.
  voucherId       String?           @unique @map("voucher_id") @db.Uuid
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  matchedById     String?           @map("matched_by_id")
  matchedAt       DateTime?         @map("matched_at") @db.Timestamptz(3)
  tag             DirectPaymentTag?
  entry           BankLineEntry?

  @@index([bankAccountId, transactionDate])
  @@map("bank_statement_line")
  @@schema("credit")
}

/// A statement credit the Finance Manager tagged to a member as a direct payment (PRD F10). Its reference is the bank_credit_ref of the DIRECT schedule row.
model DirectPaymentTag {
  id          String            @id @default(uuid()) @db.Uuid
  lineId      String            @unique @map("line_id") @db.Uuid
  line        BankStatementLine @relation(fields: [lineId], references: [id])
  memberId    String            @map("member_id") @db.Uuid
  member      Member            @relation(fields: [memberId], references: [id])
  reference   String            @unique
  /// The member's transfer receipt, where there is one.
  evidenceId  String?           @map("evidence_id") @db.Uuid
  note        String?
  taggedById  String            @map("tagged_by_id")
  taggedAt    DateTime          @default(now()) @map("tagged_at") @db.Timestamptz(3)
  /// The BANK_VERIFIED lodgement created when the DIRECT row posts.
  lodgementId String?           @unique @map("lodgement_id") @db.Uuid
  lodgement   Lodgement?        @relation("TagLodgement", fields: [lodgementId], references: [id])

  @@index([memberId])
  @@map("direct_payment_tag")
  @@schema("credit")
}

enum BankLineCategory {
  BANK_CHARGE
  BANK_INTEREST
  INTERNAL_TRANSFER

  @@schema("credit")
}

enum EntryStatus {
  PREPARED
  VERIFIED
  RETURNED

  @@schema("credit")
}

/// Bank charge, bank interest or internal transfer recorded by the Cashier from a statement line, verified by the Finance Manager (PRD F10).
model BankLineEntry {
  id            String            @id @default(uuid()) @db.Uuid
  lineId        String            @unique @map("line_id") @db.Uuid
  line          BankStatementLine @relation(fields: [lineId], references: [id])
  category      BankLineCategory
  note          String?
  status        EntryStatus       @default(PREPARED)
  recordedById  String            @map("recorded_by_id")
  recordedAt    DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(3)
  decidedById   String?           @map("decided_by_id")
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz(3)
  returnReason  String?           @map("return_reason")
  ledgerEventId String?           @map("ledger_event_id") @db.Uuid

  @@map("bank_line_entry")
  @@schema("credit")
}

// ───────────────────────────── credit: refunds (PRD F12) ─────────────────────────────

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  PAID

  @@schema("credit")
}

/// A refund of a member's Overpayment Credit (PRD F12): requested, approved by Management, paid by a voucher the Finance Manager verifies.
model Refund {
  id                   String       @id @default(uuid()) @db.Uuid
  memberId             String       @map("member_id") @db.Uuid
  member               Member       @relation(fields: [memberId], references: [id])
  amount               BigInt
  status               RefundStatus @default(REQUESTED)
  /// PORTAL (the member) or ASSISTED (a signed request captured by a Loan Officer).
  channel              String
  /// The signed request, for an assisted request.
  requestEvidenceId    String?      @map("request_evidence_id") @db.Uuid
  note                 String?
  beneficiaryName      String       @map("beneficiary_name")
  beneficiaryBank      String       @map("beneficiary_bank")
  beneficiaryAccountNo String       @map("beneficiary_account_no")
  requestedById        String       @map("requested_by_id")
  requestedAt          DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById          String?      @map("decided_by_id")
  decidedAt            DateTime?    @map("decided_at") @db.Timestamptz(3)
  decisionComment      String?      @map("decision_comment")
  paidAt               DateTime?    @map("paid_at") @db.Timestamptz(3)
  vouchers             Voucher[]

  /// One refund in progress per member.
  @@unique([memberId], map: "refund_one_open", where: raw("status IN ('REQUESTED', 'APPROVED')"))
  @@index([status, requestedAt])
  @@map("refund")
  @@schema("credit")
}

enum ReclassificationStatus {
  PREPARED
  VERIFIED
  RETURNED

  @@schema("credit")
}

/// Part of a posted repayment moved to Overpayment Credit instead of reducing the loan (PRD F12). Treasurer prepares, Finance Manager verifies.
model Reclassification {
  id            String                 @id @default(uuid()) @db.Uuid
  rowId         String                 @map("row_id") @db.Uuid
  row           RemittanceRow          @relation(fields: [rowId], references: [id])
  amount        BigInt
  reason        String
  /// The member's request.
  evidenceId    String                 @map("evidence_id") @db.Uuid
  status        ReclassificationStatus @default(PREPARED)
  preparedById  String                 @map("prepared_by_id")
  preparedAt    DateTime               @default(now()) @map("prepared_at") @db.Timestamptz(3)
  decidedById   String?                @map("decided_by_id")
  decidedAt     DateTime?              @map("decided_at") @db.Timestamptz(3)
  returnComment String?                @map("return_comment")

  @@index([rowId])
  @@map("reclassification")
  @@schema("credit")
}

// ───────────────────────────── credit: reconciliation (PRD F11) ─────────────────────────────

/// One monthly reconciliation run by the Finance Manager: Track A, Track B and the two equations, as computed then.
model ReconciliationRun {
  id      String   @id @default(uuid()) @db.Uuid
  /// YYYY-MM.
  month   String
  runById String   @map("run_by_id")
  runAt   DateTime @default(now()) @map("run_at") @db.Timestamptz(3)
  /// Per account and in total: balances, reconciling items, differences; exceptions raised.
  results Json

  @@index([month, runAt])
  @@map("reconciliation_run")
  @@schema("credit")
}

/// A closed month (PRD F11). Months close in order and are never reopened; later postings dated inside show as prior-period adjustments.
model PeriodClose {
  /// YYYY-MM.
  month        String   @id
  runId        String   @map("run_id") @db.Uuid
  closedById   String   @map("closed_by_id")
  closedAt     DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  /// The report PDFs saved as evidence at closing: [{ key, title, evidenceId }].
  snapshots    Json
  /// Ledger totals for the month at closing, per event type and money field.
  ledgerTotals Json     @map("ledger_totals")

  @@map("period_close")
  @@schema("credit")
}

// ───────────────────────────── credit: imports ─────────────────────────────

enum ImportKind {
  MEMBERS
  INVITATIONS
  REMITTANCE_SCHEDULE
  LEGACY_LOANS

  @@schema("credit")
}

enum ImportStatus {
  /// Parsed and checked; nothing written yet (the dry run).
  PREVIEWED
  COMMITTED
  /// The commit was refused: rows still had errors.
  REJECTED

  @@schema("credit")
}

/// One uploaded file and its dry run (PRD F5, F8, F9 share this pattern).
model ImportBatch {
  id            String         @id @default(uuid()) @db.Uuid
  kind          ImportKind
  filename      String
  /// Evidence id of the uploaded file itself.
  evidenceId    String?        @map("evidence_id") @db.Uuid
  /// Form fields that came with the file, e.g. a schedule header.
  header        Json?
  rowCount      Int            @map("row_count")
  errorRowCount Int            @map("error_row_count")
  status        ImportStatus   @default(PREVIEWED)
  uploadedById  String         @map("uploaded_by_id")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  committedById String?        @map("committed_by_id")
  committedAt   DateTime?      @map("committed_at") @db.Timestamptz(3)
  rows          ImportRowLog[]

  @@index([kind, uploadedAt])
  @@map("import_batch")
  @@schema("credit")
}

/// The per-row log: the row as read, its errors, and what it produced.
model ImportRowLog {
  id       String      @id @default(uuid()) @db.Uuid
  batchId  String      @map("batch_id") @db.Uuid
  batch    ImportBatch @relation(fields: [batchId], references: [id])
  rowNo    Int         @map("row_no")
  data     Json
  errors   String[]
  /// Id of the member or invitation the row created, once committed.
  entityId String?     @map("entity_id")

  @@unique([batchId, rowNo])
  @@map("import_row_log")
  @@schema("credit")
}

/// An SMS and/or email sent by the GMD or the Secretary to ACTIVE members
/// (PRD F15). Each recipient's message is a shell.notification row whose
/// idempotency key starts `announcement:<id>:`, which carries its delivery status.
model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  sentById       String   @map("sent_by_id")
  /// "ALL", or the remittance source's id.
  audience       String
  audienceLabel  String   @map("audience_label")
  viaSms         Boolean  @map("via_sms")
  viaEmail       Boolean  @map("via_email")
  subject        String?
  body           String
  recipientCount Int      @map("recipient_count")
  smsCount       Int      @map("sms_count")
  smsUnits       Int      @map("sms_units")
  emailCount     Int      @map("email_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("announcement")
  @@schema("credit")
}
