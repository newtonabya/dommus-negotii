# Copy to .env.local for development. Real values live only in Vercel environment variables.

# Neon (PRD §5): pooled connection for the app (role app_runtime),
# direct connection for migrations (owner role).
DATABASE_URL="postgresql://app_runtime:PASSWORD@HOST-pooler.REGION.aws.neon.tech/dommus?sslmode=require"
DIRECT_URL="postgresql://dommus_owner:PASSWORD@HOST.REGION.aws.neon.tech/dommus?sslmode=require"

# Database tests: the throwaway Neon `test` branch, never staging or production.
TEST_DIRECT_URL="postgresql://dommus_owner:PASSWORD@TEST-HOST.REGION.aws.neon.tech/dommus?sslmode=require"
TEST_DATABASE_URL="postgresql://app_runtime:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/dommus?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# One-time first-Admin setup at /setup. Works only while no Admin exists; remove after use.
SETUP_TOKEN="random-string"

# Evidence files. "local" (the development default) keeps them in .evidence-store/;
# "s3" (required in production) uses any S3-compatible store: Cloudflare R2 per the PRD;
# staging uses Neon Object Storage (endpoint https://<branch-id>.storage.<cell>.<region>.aws.neon.tech).
EVIDENCE_STORE="local"
# For R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto".
EVIDENCE_S3_ENDPOINT=""
EVIDENCE_S3_REGION="auto"
EVIDENCE_S3_BUCKET="dommus-evidence"
EVIDENCE_S3_ACCESS_KEY_ID=""
EVIDENCE_S3_SECRET_ACCESS_KEY=""

# Staging deployment only: "staging" writes email to the server log instead of sending it, keeps
# SMS to SMS_TEST_RECIPIENTS (or the log driver), and shows a banner on every page. Never set it in production.
APP_STAGE=""

# ── SMS (src/shell/notifications/sms). Switch providers by changing SMS_PROVIDER: no code changes.
# Development: leave SMS_PROVIDER=log (prints instead of sending, costs nothing).
# Production refuses to start if SMS_PROVIDER=log, a provider's key is missing or the sender ID
# is invalid, unless SMS_ENABLED=false.
SMS_ENABLED=true
SMS_PROVIDER=log                 # log | bulksmsnigeria | smsto | africastalking | kudisms | termii
SMS_FALLBACK_PROVIDER=           # optional: used once when the main provider is down (network/5xx), never for a bad number
SMS_SENDER_ID=                   # approved sender ID, 3-11 letters/digits (MOAUM: MOAUMCSL)
SMS_TEST_RECIPIENTS=             # staging only: comma-separated numbers allowed to receive real SMS; others are skipped
SMS_STAGING_PREFIX=[STAGING]     # put before every message outside production
SMS_WEBHOOK_SECRET=              # long random string; delivery reports go to /api/v1/sms/delivery/<provider>?token=<this>
SMS_LOG_SHOW_CODES=false         # development only: true prints one-time codes in full with the log driver

# BulkSMSNigeria (REST API v2). GATEWAY: corporate (default, transactional, reaches DND where the
# sender ID is approved), otp, direct-corporate or direct-refund. SANDBOX=true: no real SMS, no charge.
BULKSMSNIGERIA_API_TOKEN=
BULKSMSNIGERIA_GATEWAY=corporate
BULKSMSNIGERIA_SANDBOX=false
# SMS.to
SMSTO_API_KEY=
# Africa's Talking. Username "sandbox" (or SANDBOX=true) uses the free sandbox: messages show in the AT simulator.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX=true
# KudiSMS. ROUTE: corporate (default, approved corporate sender ID, reaches DND) or sms (promotional).
KUDISMS_API_KEY=
KUDISMS_ROUTE=corporate
# Termii. BASE_URL is account-specific: copy it from the Termii dashboard. ROUTE dnd = transactional.
TERMII_API_KEY=
TERMII_BASE_URL="https://api.ng.termii.com"
TERMII_ROUTE="dnd"

# Email (Resend). Without these, development prints emails; production refuses to send.
RESEND_API_KEY=""
RESEND_FROM="Dommus Negotii <no-reply@example.com>"

# .env.development.local (local `next dev` only) overrides DATABASE_URL with the
# Neon `dev` branch and holds DEV_DIRECT_URL plus the local test logins.
