# Copy to .env.local for development. Real values live only in Vercel environment variables.

# Neon (PRD §5): pooled connection for the app (role app_runtime),
# direct connection for migrations (owner role).
DATABASE_URL="postgresql://app_runtime:PASSWORD@HOST-pooler.REGION.aws.neon.tech/dommus?sslmode=require"
DIRECT_URL="postgresql://dommus_owner:PASSWORD@HOST.REGION.aws.neon.tech/dommus?sslmode=require"

# Database tests: the throwaway Neon `test` branch, never staging or production.
TEST_DIRECT_URL="postgresql://dommus_owner:PASSWORD@TEST-HOST.REGION.aws.neon.tech/dommus?sslmode=require"
TEST_DATABASE_URL="postgresql://app_runtime:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/dommus?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# One-time first-Admin setup at /setup. Works only while no Admin exists; remove after use.
SETUP_TOKEN="random-string"

# Cloudflare R2 (evidence files)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_EVIDENCE_BUCKET="dommus-evidence-dev"

# Notifications. Without these, development prints messages to the server console;
# production refuses to start a send without them.
TERMII_API_KEY=""
TERMII_SENDER_ID=""
TERMII_BASE_URL="https://api.ng.termii.com"
TERMII_ROUTE="dnd"
RESEND_API_KEY=""
RESEND_FROM="Dommus Negotii <no-reply@example.com>"

# .env.development.local (local `next dev` only) overrides DATABASE_URL with the
# Neon `dev` branch and holds DEV_DIRECT_URL plus the local test logins.
